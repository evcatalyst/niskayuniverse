---
import '../styles/global.css';
import { siteConfig, withBasePath } from '../lib/siteConfig.js';

const baseHref = withBasePath('/');
const serviceLinesUrl = withBasePath(siteConfig.dataPaths.serviceLines);
const submissionsUrl = withBasePath(siteConfig.dataPaths.submissions);
const [lat, lng] = siteConfig.map.center;
const zoom = siteConfig.map.zoom;
---

<!doctype html>
<html lang="en" data-base-path={baseHref} data-service-lines={serviceLinesUrl} data-submissions={submissionsUrl} data-submission-endpoint={siteConfig.submissionEndpoint} data-nominatim={siteConfig.nominatimEndpoint}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.municipalityName} Water Atlas</title>
    <base href={baseHref} />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <header>
      <p class="pill">Water Atlas v3</p>
      <h1>{siteConfig.municipalityName} Water Quality Atlas</h1>
      <p>Community-sourced inventory + testing, deployable on GitHub Pages.</p>
      <div style="margin-top: 16px;">
        <a href={withBasePath('dashboard')} style="display: inline-block; padding: 10px 20px; background: #0ea5e9; color: white; text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 14px; transition: all 0.2s;">
          🗺️ View Water Distribution Dashboard
        </a>
      </div>
    </header>
    <main>
      <section class="card">
        <div class="legend" aria-label="Map legend">
          <span><i style="background:#0ea5e9"></i>Service line inventory</span>
          <span><i style="background:#f97316"></i>Resident submissions</span>
          <span><i style="background:#22c55e"></i>Verified</span>
          <span><i style="background:#94a3b8"></i>Unknown</span>
        </div>
        <div id="map" role="img" aria-label="Service lines and water submissions map"></div>
      </section>

      <section class="card">
        <div class="grid">
          <div>
            <h2>Submit a new water observation</h2>
            <p>Addresses are resolved via Nominatim. Do not include sensitive information.</p>
          </div>
          <div>
            <p><strong>Data endpoints</strong></p>
            <ul>
              <li><code>{serviceLinesUrl}</code></li>
              <li><code>{submissionsUrl}</code></li>
            </ul>
          </div>
        </div>
        <form id="submission-form" class="card" style="margin-bottom:0;">
          <div>
            <label for="address">Address</label>
            <div style="position:relative;">
              <input id="address" name="address" required placeholder="Start typing an address" autocomplete="off" />
              <div id="address-suggestions" class="suggestions" hidden></div>
            </div>
          </div>
          <div>
            <label for="contact">Contact (email or phone)</label>
            <input id="contact" name="contact" placeholder="Used only for follow-up" />
          </div>
          <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
            <div>
              <label for="ph">pH (0-14)</label>
              <input id="ph" name="ph" type="number" step="0.1" min="0" max="14" />
            </div>
            <div>
              <label for="tds">TDS (ppm)</label>
              <input id="tds" name="tds" type="number" min="0" />
            </div>
            <div>
              <label for="temperature">Temperature (°F)</label>
              <input id="temperature" name="temperature" type="number" step="0.1" />
            </div>
            <div>
              <label for="lead">Lead (ppb)</label>
              <input id="lead" name="lead" type="number" min="0" />
            </div>
          </div>
          <div>
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="3" placeholder="Sampling conditions, lab, etc. (optional)"></textarea>
          </div>
          <button type="submit" id="submit-btn">Send submission</button>
          <div id="form-status" class="status" aria-live="polite" hidden></div>
        </form>
      </section>
    </main>

    <script define:vars={{ lat, lng, zoom }}>
      const config = {
        basePath: document.documentElement.dataset.basePath,
        serviceLinesUrl: document.documentElement.dataset.serviceLines,
        submissionsUrl: document.documentElement.dataset.submissions,
        submissionEndpoint: document.documentElement.dataset.submissionEndpoint,
        nominatimEndpoint: document.documentElement.dataset.nominatim,
        mapCenter: [lat, lng],
        mapZoom: zoom,
      };

      const serviceLineColors = {
        verified: '#22c55e',
        unknown: '#94a3b8',
        default: '#0ea5e9',
      };

      const submissionColor = '#f97316';
      let map;
      let selectedAddress = null;

      function showStatus(message, kind = 'success') {
        const el = document.getElementById('form-status');
        el.textContent = message;
        el.className = `status ${kind}`;
        el.hidden = false;
      }

      function clearStatus() {
        const el = document.getElementById('form-status');
        el.hidden = true;
        el.textContent = '';
      }

      function materialLabel(feature) {
        const props = feature.properties || {};
        return [
          props.private_material ? `Private: ${props.private_material}` : null,
          props.public_material ? `Public: ${props.public_material}` : null,
        ]
          .filter(Boolean)
          .join(' · ');
      }

      async function loadServiceLines() {
        try {
          const res = await fetch(config.serviceLinesUrl, { cache: 'no-store' });
          if (!res.ok) throw new Error(`Failed to load service lines (${res.status})`);
          const data = await res.json();
          const layer = L.geoJSON(data, {
            pointToLayer: (feature, latlng) => {
              const status = (feature.properties?.status || '').toLowerCase();
              const color = serviceLineColors[status] || serviceLineColors.default;
              return L.circleMarker(latlng, {
                radius: 7,
                color,
                weight: 2,
                fillColor: color,
                fillOpacity: 0.7,
              });
            },
            onEachFeature: (feature, layer) => {
              const props = feature.properties || {};
              const label = materialLabel(feature) || 'Service line';
              layer.bindPopup(
                `<strong>${props.address || 'Unknown address'}</strong><br/>${label}<br/>Status: ${
                  props.status || 'n/a'
                }${props.updated ? `<br/>Updated: ${props.updated}` : ''}`
              );
            },
          });
          layer.addTo(map);
        } catch (error) {
          console.error(error);
          showStatus('Unable to load service line inventory.', 'error');
        }
      }

      function addSubmissionMarker(entry) {
        if (!entry.coordinates) return;
        const { lat, lng } = entry.coordinates;
        if (!isFinite(lat) || !isFinite(lng)) return;
        const marker = L.circleMarker([lat, lng], {
          radius: 6,
          color: submissionColor,
          weight: 2,
          fillColor: submissionColor,
          fillOpacity: 0.8,
        });
        const summary = [
          entry.ph ? `pH: ${entry.ph}` : null,
          entry.tds ? `TDS: ${entry.tds} ppm` : null,
          entry.leadPpb ? `Lead: ${entry.leadPpb} ppb` : null,
        ]
          .filter(Boolean)
          .join('<br/>');
        marker.bindPopup(
          `<strong>${entry.address}</strong><br/>${summary || 'Resident submission'}<br/>${entry.submittedAt || ''}`
        );
        marker.addTo(map);
      }

      async function loadSubmissions() {
        try {
          const res = await fetch(config.submissionsUrl, { cache: 'no-store' });
          if (!res.ok) throw new Error(`Failed to load submissions (${res.status})`);
          const submissions = await res.json();
          submissions.forEach(addSubmissionMarker);
        } catch (error) {
          console.error(error);
          showStatus('Unable to load recent submissions.', 'error');
        }
      }

      async function geocodeAddress(query) {
        const params = new URLSearchParams({
          format: 'jsonv2',
          q: query,
          limit: '5',
        });
        const url = `${config.nominatimEndpoint}?${params.toString()}`;
        const res = await fetch(url, { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(`Geocoding failed (${res.status})`);
        return res.json();
      }

      function bindSuggestions() {
        const input = document.getElementById('address');
        const suggestions = document.getElementById('address-suggestions');
        let debounce;

        input.addEventListener('input', () => {
          clearTimeout(debounce);
          const query = input.value.trim();
          if (query.length < 3) {
            suggestions.hidden = true;
            suggestions.innerHTML = '';
            return;
          }
          debounce = setTimeout(async () => {
            try {
              const results = await geocodeAddress(query);
              suggestions.innerHTML = '';
              results.forEach((item) => {
                const div = document.createElement('div');
                div.textContent = item.display_name;
                div.addEventListener('click', () => {
                  selectedAddress = {
                    label: item.display_name,
                    coordinates: { lat: Number(item.lat), lng: Number(item.lon) },
                  };
                  input.value = item.display_name;
                  suggestions.hidden = true;
                  suggestions.innerHTML = '';
                  if (map && selectedAddress?.coordinates) {
                    map.flyTo([selectedAddress.coordinates.lat, selectedAddress.coordinates.lng], Math.max(14, map.getZoom()));
                  }
                });
                suggestions.appendChild(div);
              });
              suggestions.hidden = results.length === 0;
            } catch (error) {
              console.warn('Autocomplete unavailable', error);
              suggestions.hidden = true;
            }
          }, 350);
        });
      }

      async function resolveCoordinates(address) {
        if (selectedAddress?.label === address && selectedAddress?.coordinates) {
          return selectedAddress.coordinates;
        }
        const results = await geocodeAddress(address);
        if (!results?.length) throw new Error('Address could not be geocoded');
        return { lat: Number(results[0].lat), lng: Number(results[0].lon) };
      }

      function bindForm() {
        const form = document.getElementById('submission-form');
        const submitBtn = document.getElementById('submit-btn');

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          clearStatus();

          const formData = new FormData(form);
          const address = String(formData.get('address') || '').trim();
          if (!address) {
            showStatus('Address is required.', 'error');
            return;
          }

          submitBtn.disabled = true;
          showStatus('Submitting…', 'success');

          try {
            const coordinates = await resolveCoordinates(address);
            const payload = {
              address,
              contact: String(formData.get('contact') || '').trim(),
              ph: Number(formData.get('ph')) || null,
              tds: Number(formData.get('tds')) || null,
              temperatureF: Number(formData.get('temperature')) || null,
              leadPpb: Number(formData.get('lead')) || null,
              notes: String(formData.get('notes') || '').trim(),
              coordinates,
              submittedAt: new Date().toISOString(),
            };

            const response = await fetch(config.submissionEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (!response.ok) {
              const text = await response.text();
              throw new Error(text || `Submission failed (${response.status})`);
            }

            showStatus('Thank you! Your submission has been recorded.', 'success');
            addSubmissionMarker({ ...payload, status: 'received' });
            form.reset();
            selectedAddress = null;
          } catch (error) {
            console.error(error);
            showStatus(error.message || 'Submission failed. Please try again.', 'error');
          } finally {
            submitBtn.disabled = false;
          }
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        map = L.map('map', { scrollWheelZoom: true }).setView(config.mapCenter, config.mapZoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; OpenStreetMap contributors',
        }).addTo(map);

        bindSuggestions();
        bindForm();
        loadServiceLines();
        loadSubmissions();
      });
    </script>
  </body>
</html>
