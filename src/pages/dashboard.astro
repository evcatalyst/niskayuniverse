---
import '../styles/global.css';
import { siteConfig, withBasePath } from '../lib/siteConfig.js';

const baseHref = withBasePath('/');
const registryUrl = withBasePath('config/layers.registry.json');
const [lat, lng] = siteConfig.map.center;
const zoom = siteConfig.map.zoom;
---

<!doctype html>
<html lang="en" data-base-path={baseHref} data-registry={registryUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.municipalityName} Water Dashboard</title>
    <base href={baseHref} />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
      /* Reset and Base Styles */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
        background: #f8fafc;
        color: #0f172a;
        overflow: hidden;
      }

      /* Full-screen Map Container */
      #map-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 0;
      }

      #map {
        width: 100%;
        height: 100%;
      }

      /* Header - Minimalist, Floating */
      header {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 12px 32px;
        border-radius: 999px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      header h1 {
        font-size: 16px;
        font-weight: 600;
        color: #0f172a;
        letter-spacing: -0.02em;
      }

      .water-icon {
        width: 20px;
        height: 20px;
        color: #0ea5e9;
      }

      /* Layer Controls - Minimalist Toggle Panel */
      .controls-panel {
        position: fixed;
        top: 90px;
        right: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 16px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1000;
        min-width: 200px;
        max-width: 280px;
      }

      .controls-panel h3 {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .controls-panel label {
        display: flex;
        align-items: center;
        margin: 8px 0;
        font-size: 14px;
        color: #475569;
        cursor: pointer;
        transition: color 0.2s;
      }

      .controls-panel label:hover {
        color: #0ea5e9;
      }

      .controls-panel input[type="checkbox"] {
        margin-right: 8px;
        width: 16px;
        height: 16px;
        cursor: pointer;
      }

      /* Analysis Mode Selector */
      .mode-selector {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e2e8f0;
      }

      .mode-selector-label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
        display: block;
      }

      .mode-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
      }

      .mode-btn {
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 500;
        border: 1px solid #e2e8f0;
        background: white;
        color: #475569;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
      }

      .mode-btn:hover {
        border-color: #0ea5e9;
        color: #0ea5e9;
      }

      .mode-btn.active {
        background: #0ea5e9;
        color: white;
        border-color: #0ea5e9;
      }

      .mode-description {
        font-size: 11px;
        color: #64748b;
        margin-top: 8px;
        line-height: 1.4;
      }

      /* Layer toggles section */
      .layer-toggles {
        margin-top: 12px;
      }

      .layer-group {
        margin-bottom: 8px;
      }

      .layer-group-title {
        font-size: 10px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
      }

      /* Information Panel - Slide-in from Bottom */
      .info-panel {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        padding: 24px 32px;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.12);
        z-index: 1000;
        transform: translateY(calc(100% - 60px));
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        max-height: 60vh;
        overflow-y: auto;
      }

      .info-panel.expanded {
        transform: translateY(0);
      }

      .info-panel-handle {
        width: 40px;
        height: 4px;
        background: #cbd5e1;
        border-radius: 2px;
        margin: 0 auto 16px;
        cursor: pointer;
      }

      .info-panel h2 {
        font-size: 20px;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 16px;
      }

      .info-content {
        display: none;
      }

      .info-panel.expanded .info-content {
        display: block;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-top: 16px;
      }

      .info-item {
        padding: 12px;
        background: #f8fafc;
        border-radius: 8px;
      }

      .info-item label {
        display: block;
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
      }

      .info-item .value {
        font-size: 16px;
        font-weight: 600;
        color: #0f172a;
      }

      /* Legend - Clean, Bottom Left */
      .legend {
        position: fixed;
        bottom: 20px;
        left: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 16px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1000;
        max-width: 220px;
      }

      .legend h4 {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .legend-section {
        margin-bottom: 12px;
      }

      .legend-section:last-child {
        margin-bottom: 0;
      }

      .legend-section-title {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 6px;
        font-weight: 600;
      }

      .legend-item {
        display: flex;
        align-items: center;
        margin: 6px 0;
        font-size: 13px;
        color: #475569;
      }

      .legend-color {
        width: 16px;
        height: 16px;
        margin-right: 8px;
        border-radius: 4px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        flex-shrink: 0;
      }

      /* About Panel - Modal Overlay */
      .about-panel {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .about-panel.visible {
        display: flex;
      }

      .about-content {
        background: white;
        padding: 32px;
        border-radius: 16px;
        max-width: 600px;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      .about-content h2 {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 16px;
        color: #0f172a;
      }

      .about-content h3 {
        font-size: 16px;
        font-weight: 600;
        margin-top: 20px;
        margin-bottom: 8px;
        color: #334155;
      }

      .about-content p,
      .about-content li {
        font-size: 14px;
        line-height: 1.6;
        color: #475569;
        margin-bottom: 12px;
      }

      .about-content ul {
        padding-left: 20px;
      }

      .about-content a {
        color: #0ea5e9;
        text-decoration: none;
      }

      .about-content a:hover {
        text-decoration: underline;
      }

      .close-btn {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 32px;
        height: 32px;
        border: none;
        background: #f1f5f9;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #64748b;
        transition: all 0.2s;
      }

      .close-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
      }

      /* About Button */
      .about-btn {
        position: fixed;
        top: 20px;
        right: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1000;
        transition: all 0.2s;
      }

      .about-btn:hover {
        background: white;
        color: #0ea5e9;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
      }

      /* Leaflet Popup Customization */
      .leaflet-popup-content {
        margin: 12px 16px;
        font-size: 13px;
        line-height: 1.5;
      }

      .leaflet-popup-content strong {
        color: #0f172a;
        font-weight: 600;
      }

      .popup-row {
        margin: 6px 0;
        color: #475569;
      }

      /* Mobile Responsive */
      @media (max-width: 768px) {
        header {
          top: 12px;
          padding: 10px 20px;
        }

        header h1 {
          font-size: 14px;
        }

        .controls-panel {
          top: 70px;
          right: 12px;
          padding: 12px 16px;
          min-width: 160px;
        }

        .legend {
          bottom: 80px;
          left: 12px;
          padding: 12px 16px;
        }

        .info-panel {
          padding: 20px 24px;
        }

        .about-btn {
          top: 12px;
          right: 12px;
          padding: 8px 14px;
          font-size: 13px;
        }

        .about-content {
          padding: 24px;
          margin: 20px;
        }
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <header>
      <svg class="water-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
      </svg>
      <h1>{siteConfig.municipalityName} Water Distribution Dashboard</h1>
    </header>

    <!-- About Button -->
    <button class="about-btn" id="about-btn">About / Data Sources</button>

    <!-- Controls Panel -->
    <aside class="controls-panel">
      <div class="mode-selector">
        <span class="mode-selector-label">Analysis Mode</span>
        <div class="mode-buttons" id="mode-buttons">
          <!-- Mode buttons will be populated by JavaScript from registry -->
        </div>
        <div class="mode-description" id="mode-description">
          <!-- Mode description will be populated by JavaScript -->
        </div>
      </div>
      
      <h3>Layers</h3>
      <div class="layer-toggles" id="layer-toggles">
        <!-- Layer toggles will be populated by JavaScript from registry -->
      </div>
    </aside>

    <!-- Legend -->
    <aside class="legend" id="legend">
      <h4>Legend</h4>
      <div id="legend-content">
        <!-- Legend content will be populated by JavaScript from registry -->
      </div>
    </aside>

    <!-- Information Panel -->
    <section class="info-panel" id="info-panel">
      <div class="info-panel-handle" id="panel-handle"></div>
      <h2>Water System Overview</h2>
      <div class="info-content">
        <div class="info-grid">
          <div class="info-item">
            <label>System Name</label>
            <div class="value">Town of Niskayuna</div>
          </div>
          <div class="info-item">
            <label>Population Served</label>
            <div class="value">~21,000</div>
          </div>
          <div class="info-item">
            <label>Water Source</label>
            <div class="value">Groundwater Wells</div>
          </div>
          <div class="info-item">
            <label>Supplier</label>
            <div class="value">Self-supplied</div>
          </div>
        </div>
        <p style="margin-top: 16px; font-size: 14px; color: #64748b; line-height: 1.6;">
          This dashboard provides a comprehensive view of the water distribution infrastructure and quality data for the Town of Niskayuna. 
          Click on map features to explore detailed information about parcels, service lines, and resident-submitted water quality data.
        </p>
      </div>
    </section>

    <!-- About Panel (Modal) -->
    <div class="about-panel" id="about-panel">
      <div class="about-content">
        <button class="close-btn" id="close-about" aria-label="Close">×</button>
        <h2>About This Dashboard</h2>
        <p>
          This open-data-driven water distribution dashboard provides transparent access to water infrastructure and quality information 
          for the Town of Niskayuna, NY. The platform is designed with simplicity and clarity in mind, making complex data accessible 
          to residents, board members, and municipal staff.
        </p>

        <h3>Design Philosophy</h3>
        <p>
          Following principles of minimalism and user-centered design, this dashboard emphasizes clarity over clutter. 
          Every element serves a purpose, providing powerful insights while maintaining an intuitive interface that requires 
          no technical expertise to navigate.
        </p>

        <h3>Data Sources & Provenance</h3>
        <div id="provenance-list">
          <!-- Provenance information will be populated by JavaScript from registry -->
          <p style="color: #64748b; font-size: 13px;">Loading data sources...</p>
        </div>

        <h3>Technology Stack</h3>
        <p>
          Built with open-source technologies and hosted on GitHub Pages, this dashboard requires no API keys or proprietary services:
        </p>
        <ul>
          <li><strong>Mapping:</strong> Leaflet.js with OpenStreetMap tiles</li>
          <li><strong>Hosting:</strong> GitHub Pages (free, static hosting)</li>
          <li><strong>Automation:</strong> GitHub Actions for data updates</li>
          <li><strong>Framework:</strong> Astro (static site generation)</li>
        </ul>

        <h3>White-Labeling</h3>
        <p>
          This dashboard template can be easily adapted for other municipalities by updating the configuration file 
          and swapping data sources. No code changes required for basic customization.
        </p>

        <h3>Open Source</h3>
        <p>
          This project is open source and available on GitHub. Contributions, feedback, and adaptations are welcome.
        </p>
      </div>
    </div>

    <!-- Map Container -->
    <div id="map-container">
      <div id="map"></div>
    </div>

    <script define:vars={{ lat, lng, zoom }}>
      // Configuration
      const config = {
        basePath: document.documentElement.dataset.basePath,
        registryUrl: document.documentElement.dataset.registry,
        mapCenter: [lat, lng],
        mapZoom: zoom,
      };

      // Global state
      let map;
      let registry = null;
      let layers = new Map(); // layerId -> Leaflet layer object
      let layerVisibility = new Map(); // layerId -> boolean
      let currentMode = 'overview';

      // LOD threshold
      const LOD_ZOOM_THRESHOLD = 15;

      // HTML escaping for security
      function escapeHtml(value) {
        if (value === null || value === undefined) return '';
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // Path helper
      function withBasePath(path) {
        if (!path) return path;
        if (path.startsWith('http')) return path;
        const base = config.basePath || '/';
        const cleanPath = path.startsWith('/') ? path.slice(1) : path;
        return base + cleanPath;
      }

      // Load layer registry
      async function loadRegistry() {
        try {
          const res = await fetch(config.registryUrl);
          if (!res.ok) throw new Error(`Failed to load registry (${res.status})`);
          registry = await res.json();
          console.log('Layer registry loaded:', registry);
          return registry;
        } catch (error) {
          console.error('Error loading registry:', error);
          return null;
        }
      }

      // Get color from layer style
      function getLayerColor(layer) {
        if (layer.style?.color) return layer.style.color;
        if (layer.legend?.color) return layer.legend.color;
        return '#64748b';
      }

      // Render mode buttons
      function renderModeButtons() {
        const container = document.getElementById('mode-buttons');
        const description = document.getElementById('mode-description');
        
        if (!registry?.modes) return;
        
        container.innerHTML = registry.modes.map(mode => `
          <button class="mode-btn ${mode.id === currentMode ? 'active' : ''}" 
                  data-mode="${escapeHtml(mode.id)}">
            ${escapeHtml(mode.label)}
          </button>
        `).join('');

        // Set initial description
        const activeMode = registry.modes.find(m => m.id === currentMode);
        if (activeMode) {
          description.textContent = activeMode.description;
        }

        // Add click handlers
        container.querySelectorAll('.mode-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const modeId = btn.dataset.mode;
            setMode(modeId);
          });
        });
      }

      // Set analysis mode
      function setMode(modeId) {
        const mode = registry.modes.find(m => m.id === modeId);
        if (!mode) return;

        currentMode = modeId;

        // Update button states
        document.querySelectorAll('.mode-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.mode === modeId);
        });

        // Update description
        const description = document.getElementById('mode-description');
        description.textContent = mode.description;

        // Update layer visibility
        if (mode.enable_layers) {
          mode.enable_layers.forEach(layerId => {
            layerVisibility.set(layerId, true);
            updateLayerVisibility(layerId, true);
          });
        }

        if (mode.disable_layers) {
          mode.disable_layers.forEach(layerId => {
            layerVisibility.set(layerId, false);
            updateLayerVisibility(layerId, false);
          });
        }

        // Update legend
        renderLegend(mode.legend_profile || 'default');

        // Update layer toggles UI
        updateLayerToggles();
      }

      // Render layer toggles
      function renderLayerToggles() {
        const container = document.getElementById('layer-toggles');
        if (!registry?.layers) return;

        // Group layers by group
        const groups = {};
        registry.layers.forEach(layer => {
          if (!groups[layer.group]) groups[layer.group] = [];
          groups[layer.group].push(layer);
        });

        container.innerHTML = Object.entries(groups).map(([groupName, groupLayers]) => `
          <div class="layer-group">
            <div class="layer-group-title">${escapeHtml(groupName)}</div>
            ${groupLayers.map(layer => {
              const checked = layerVisibility.get(layer.id) !== false;
              return `
                <label>
                  <input type="checkbox" 
                         data-layer="${escapeHtml(layer.id)}" 
                         ${checked ? 'checked' : ''} />
                  ${escapeHtml(layer.label)}
                </label>
              `;
            }).join('')}
          </div>
        `).join('');

        // Add change handlers
        container.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
          checkbox.addEventListener('change', (e) => {
            const layerId = e.target.dataset.layer;
            const visible = e.target.checked;
            layerVisibility.set(layerId, visible);
            updateLayerVisibility(layerId, visible);
          });
        });
      }

      // Update layer toggles UI only (don't change visibility)
      function updateLayerToggles() {
        document.querySelectorAll('#layer-toggles input[type="checkbox"]').forEach(checkbox => {
          const layerId = checkbox.dataset.layer;
          const visible = layerVisibility.get(layerId) !== false;
          checkbox.checked = visible;
        });
      }

      // Render legend
      function renderLegend(profileId = 'default') {
        const container = document.getElementById('legend-content');
        const profile = registry.legend_profiles?.[profileId];
        
        if (!profile?.sections) {
          container.innerHTML = '<p style="color: #64748b; font-size: 12px;">No legend available</p>';
          return;
        }

        container.innerHTML = profile.sections.map(section => {
          const sectionLayers = section.items.map(layerId => 
            registry.layers.find(l => l.id === layerId)
          ).filter(Boolean);

          return `
            <div class="legend-section">
              <div class="legend-section-title">${escapeHtml(section.label)}</div>
              ${sectionLayers.map(layer => {
                if (layer.legend?.swatch === 'categories' && layer.legend?.categories) {
                  return layer.legend.categories.map(cat => `
                    <div class="legend-item">
                      <div class="legend-color" style="background-color: ${escapeHtml(cat.color)};"></div>
                      <span>${escapeHtml(cat.label)}</span>
                    </div>
                  `).join('');
                } else if (layer.legend?.swatch === 'line') {
                  const color = getLayerColor(layer);
                  const isDashed = layer.style?.dash;
                  return `
                    <div class="legend-item">
                      <div class="legend-color" style="background-color: ${escapeHtml(color)}; ${isDashed ? 'opacity: 0.3; border: 2px dashed ' + escapeHtml(color) : ''}"></div>
                      <span>${escapeHtml(layer.legend.text || layer.label)}</span>
                    </div>
                  `;
                } else if (layer.legend?.swatch === 'fill') {
                  const color = getLayerColor(layer);
                  return `
                    <div class="legend-item">
                      <div class="legend-color" style="background-color: ${escapeHtml(color)}; opacity: 0.5;"></div>
                      <span>${escapeHtml(layer.legend.text || layer.label)}</span>
                    </div>
                  `;
                } else {
                  const color = getLayerColor(layer);
                  return `
                    <div class="legend-item">
                      <div class="legend-color" style="background-color: ${escapeHtml(color)};"></div>
                      <span>${escapeHtml(layer.legend?.text || layer.label)}</span>
                    </div>
                  `;
                }
              }).join('')}
            </div>
          `;
        }).join('');
      }

      // Render provenance list
      function renderProvenance() {
        const container = document.getElementById('provenance-list');
        if (!registry?.layers) return;

        container.innerHTML = '<ul style="padding-left: 20px; margin-top: 12px;">' + 
          registry.layers.map(layer => {
            const prov = layer.provenance;
            if (!prov) return '';
            
            return `
              <li style="margin-bottom: 16px;">
                <strong>${escapeHtml(layer.label)}</strong><br/>
                <span style="font-size: 12px; color: #64748b;">
                  Source: ${escapeHtml(prov.source_name)}<br/>
                  ${prov.source_url && prov.source_url !== 'Municipal Records' && prov.source_url !== 'Community-sourced' && prov.source_url !== 'Derived from road classification' && prov.source_url !== 'NYS DEC' ? 
                    `URL: <a href="${escapeHtml(prov.source_url)}" target="_blank" rel="noopener">${escapeHtml(prov.source_url)}</a><br/>` : ''}
                  License: ${escapeHtml(prov.license)}<br/>
                  Completeness: ${escapeHtml(prov.completeness)}
                </span>
              </li>
            `;
          }).filter(Boolean).join('') + '</ul>' +
          '<p style="margin-top: 16px; font-size: 13px; color: #64748b;"><strong>Base Map:</strong> OpenStreetMap contributors (<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a>)</p>';
      }

      // Load a layer from registry
      async function loadLayer(layerDef) {
        try {
          const path = withBasePath(layerDef.path);
          const res = await fetch(path);
          
          if (!res.ok) {
            console.log(`Layer ${layerDef.id} not available (${res.status})`);
            return null;
          }

          let data = await res.json();
          
          // Convert submissions.json format to GeoJSON if needed
          if (layerDef.id === 'resident_submissions' && Array.isArray(data)) {
            const features = data
              .filter(s => s.coordinates && s.coordinates.lat && s.coordinates.lng)
              .map(s => ({
                type: 'Feature',
                properties: s,
                geometry: { type: 'Point', coordinates: [s.coordinates.lng, s.coordinates.lat] }
              }));
            data = { type: 'FeatureCollection', features };
          }

          let leafletLayer;

          if (layerDef.geometry === 'point') {
            leafletLayer = L.geoJSON(data, {
              pointToLayer: (feature, latlng) => {
                const color = layerDef.style?.color || getLayerColor(layerDef);
                const radius = layerDef.style?.point_radius || 5;
                const opacity = layerDef.style?.point_opacity || 0.8;
                
                return L.circleMarker(latlng, {
                  radius: radius,
                  color: color,
                  weight: 2,
                  fillColor: color,
                  fillOpacity: opacity
                });
              },
              onEachFeature: (feature, layer) => {
                if (layerDef.tooltip?.text) {
                  layer.bindTooltip(layerDef.tooltip.text);
                }
                if (feature.properties) {
                  const popupContent = createPopupContent(layerDef, feature.properties);
                  if (popupContent) layer.bindPopup(popupContent);
                }
              }
            });
          } else if (layerDef.geometry === 'line') {
            leafletLayer = L.geoJSON(data, {
              style: {
                color: layerDef.style?.color || getLayerColor(layerDef),
                weight: layerDef.style?.stroke_width || 2,
                opacity: layerDef.style?.stroke_opacity || 0.7,
                dashArray: layerDef.style?.dash ? layerDef.style.dash.join(', ') : undefined
              },
              onEachFeature: (feature, layer) => {
                if (layerDef.tooltip?.text) {
                  layer.bindTooltip(layerDef.tooltip.text);
                }
                if (feature.properties) {
                  const popupContent = createPopupContent(layerDef, feature.properties);
                  if (popupContent) layer.bindPopup(popupContent);
                }
              }
            });
          } else if (layerDef.geometry === 'polygon') {
            // Handle parcels with LOD
            if (layerDef.id === 'parcels') {
              return loadParcelsWithLOD(data, layerDef);
            }
            
            leafletLayer = L.geoJSON(data, {
              style: {
                fillColor: layerDef.style?.color || getLayerColor(layerDef),
                fillOpacity: layerDef.style?.fill_opacity || 0.1,
                color: layerDef.style?.color || getLayerColor(layerDef),
                weight: layerDef.style?.stroke_width || 1,
                opacity: layerDef.style?.stroke_opacity || 0.5,
                dashArray: layerDef.style?.dash ? layerDef.style.dash.join(', ') : undefined
              },
              onEachFeature: (feature, layer) => {
                if (layerDef.tooltip?.text) {
                  layer.bindTooltip(layerDef.tooltip.text);
                }
                if (feature.properties) {
                  const popupContent = createPopupContent(layerDef, feature.properties);
                  if (popupContent) layer.bindPopup(popupContent);
                }
                
                // Add hover effect
                layer.on('mouseover', function () {
                  this.setStyle({ weight: 2, opacity: 1 });
                });
                layer.on('mouseout', function () {
                  this.setStyle({ 
                    weight: layerDef.style?.stroke_width || 1, 
                    opacity: layerDef.style?.stroke_opacity || 0.5 
                  });
                });
              }
            });
          }

          return leafletLayer;
        } catch (error) {
          console.error(`Error loading layer ${layerDef.id}:`, error);
          return null;
        }
      }

      // Load parcels with LOD support
      async function loadParcelsWithLOD(data, layerDef) {
        // Create polygon layer
        const polygonLayer = L.geoJSON(data, {
          style: (feature) => {
            const yearBuilt = feature.properties?.year_built;
            const color = getAgeColor(yearBuilt);
            return {
              fillColor: color,
              fillOpacity: 0.5,
              color: '#64748b',
              weight: 1,
              opacity: 0.6
            };
          },
          onEachFeature: (feature, layer) => {
            const popupContent = createParcelPopup(feature.properties);
            if (popupContent) layer.bindPopup(popupContent);
            
            layer.on('mouseover', function () {
              this.setStyle({ weight: 2, opacity: 1 });
            });
            layer.on('mouseout', function () {
              this.setStyle({ weight: 1, opacity: 0.6 });
            });
          }
        });

        // Create centroid layer
        const centroids = {
          type: 'FeatureCollection',
          features: data.features.map(f => {
            let coords;
            if (f.geometry.type === 'Polygon') {
              coords = f.geometry.coordinates[0];
            } else if (f.geometry.type === 'MultiPolygon') {
              coords = f.geometry.coordinates[0][0];
            } else {
              return null;
            }
            
            const lats = coords.map(c => c[1]);
            const lngs = coords.map(c => c[0]);
            const centroidLat = lats.reduce((a, b) => a + b, 0) / lats.length;
            const centroidLng = lngs.reduce((a, b) => a + b, 0) / lngs.length;
            
            return {
              type: 'Feature',
              properties: f.properties,
              geometry: { type: 'Point', coordinates: [centroidLng, centroidLat] }
            };
          }).filter(Boolean)
        };

        const centroidLayer = L.geoJSON(centroids, {
          pointToLayer: (feature, latlng) => {
            const yearBuilt = feature.properties?.year_built;
            const color = getAgeColor(yearBuilt);
            return L.circleMarker(latlng, {
              radius: 4,
              fillColor: color,
              color: '#64748b',
              weight: 1,
              opacity: 0.6,
              fillOpacity: 0.7
            });
          },
          onEachFeature: (feature, layer) => {
            const popupContent = createParcelPopup(feature.properties);
            if (popupContent) layer.bindPopup(popupContent);
          }
        });

        // Return LOD wrapper
        return {
          _isLOD: true,
          _polygonLayer: polygonLayer,
          _centroidLayer: centroidLayer,
          _currentLayer: null,
          addTo: function(map) {
            this._map = map;
            this._updateLOD();
            return this;
          },
          remove: function() {
            if (this._currentLayer) {
              this._map.removeLayer(this._currentLayer);
              this._currentLayer = null;
            }
            return this;
          },
          _updateLOD: function() {
            if (!this._map) return;
            
            const zoom = this._map.getZoom();
            const shouldShowPolygons = zoom >= LOD_ZOOM_THRESHOLD;
            
            if (shouldShowPolygons && this._currentLayer !== this._polygonLayer) {
              if (this._currentLayer) this._map.removeLayer(this._currentLayer);
              this._map.addLayer(this._polygonLayer);
              this._currentLayer = this._polygonLayer;
            } else if (!shouldShowPolygons && this._currentLayer !== this._centroidLayer) {
              if (this._currentLayer) this._map.removeLayer(this._currentLayer);
              this._map.addLayer(this._centroidLayer);
              this._currentLayer = this._centroidLayer;
            }
          }
        };
      }

      // Color mapping for building age
      function getAgeColor(yearBuilt) {
        if (!yearBuilt || yearBuilt === null) return '#94a3b8';
        if (yearBuilt < 1920) return '#7c2d12';
        if (yearBuilt >= 1920 && yearBuilt <= 1950) return '#ea580c';
        if (yearBuilt >= 1951 && yearBuilt <= 1986) return '#fbbf24';
        return '#4ade80';
      }

      function getAgeCategory(yearBuilt) {
        if (!yearBuilt || yearBuilt === null) return 'Unknown';
        if (yearBuilt < 1920) return 'Pre-1920';
        if (yearBuilt >= 1920 && yearBuilt <= 1950) return '1920–1950';
        if (yearBuilt >= 1951 && yearBuilt <= 1986) return '1951–1986 (Lead Era)';
        return 'Post-1986';
      }

      // Create popup content based on layer type
      function createPopupContent(layerDef, props) {
        if (layerDef.id === 'service_lines_points') {
          return createServiceLinePopup(props);
        } else if (layerDef.id === 'resident_submissions') {
          return createSubmissionPopup(props);
        } else if (layerDef.id === 'service_area_boundary') {
          return createServiceAreaPopup(props);
        }
        
        // Generic popup
        return `<strong>${escapeHtml(layerDef.label)}</strong>`;
      }

      function createParcelPopup(props) {
        const yearBuilt = escapeHtml(props.year_built || 'Unknown');
        const ageCategory = escapeHtml(getAgeCategory(props.year_built));
        const address = escapeHtml(props.address || props.street_addr || 'N/A');
        const parcelId = escapeHtml(props.parcel_id || 'N/A');
        
        return `
          <strong>${address}</strong>
          <div class="popup-row"><strong>Parcel ID:</strong> ${parcelId}</div>
          <div class="popup-row"><strong>Year Built:</strong> ${yearBuilt}</div>
          <div class="popup-row"><strong>Age Category:</strong> ${ageCategory}</div>
          ${props.owner_name ? `<div class="popup-row"><strong>Owner:</strong> ${escapeHtml(props.owner_name)}</div>` : ''}
        `;
      }

      function createServiceLinePopup(props) {
        const address = escapeHtml(props.address || 'Unknown address');
        const privateMaterial = props.private_material ? escapeHtml(props.private_material) : 'Unknown';
        const publicMaterial = props.public_material ? escapeHtml(props.public_material) : 'Unknown';
        const status = props.status ? escapeHtml(props.status) : 'Unknown';
        
        return `
          <strong>${address}</strong>
          <div class="popup-row"><strong>Private Material:</strong> ${privateMaterial}</div>
          <div class="popup-row"><strong>Public Material:</strong> ${publicMaterial}</div>
          <div class="popup-row"><strong>Status:</strong> ${status}</div>
          ${props.updated ? `<div class="popup-row"><strong>Updated:</strong> ${escapeHtml(props.updated)}</div>` : ''}
        `;
      }

      function createSubmissionPopup(entry) {
        const address = escapeHtml(entry.address || 'Unknown');
        const summary = [
          entry.ph ? `pH: ${entry.ph}` : null,
          entry.tds ? `TDS: ${entry.tds} ppm` : null,
          entry.leadPpb ? `Lead: ${entry.leadPpb} ppb` : null,
        ].filter(Boolean).join('<br/>');
        
        return `
          <strong>${address}</strong>
          ${summary ? `<div class="popup-row">${summary}</div>` : ''}
          <div class="popup-row">${escapeHtml(entry.submittedAt || '')}</div>
        `;
      }

      function createServiceAreaPopup(props) {
        return `
          <strong>${escapeHtml(props.PWS_NAME || 'Water Service Area')}</strong>
          ${props.POPULATION_SERVED ? `<div class="popup-row"><strong>Population Served:</strong> ${escapeHtml(props.POPULATION_SERVED.toLocaleString())}</div>` : ''}
          ${props.WATER_SOURCE_TYPE ? `<div class="popup-row"><strong>Water Source:</strong> ${escapeHtml(props.WATER_SOURCE_TYPE)}</div>` : ''}
          ${props.SUPPLIER_TYPE ? `<div class="popup-row"><strong>Supplier:</strong> ${escapeHtml(props.SUPPLIER_TYPE)}</div>` : ''}
          ${props.SOURCE_WATER ? `<div class="popup-row"><strong>Source:</strong> ${escapeHtml(props.SOURCE_WATER)}</div>` : ''}
        `;
      }

      // Update layer visibility
      function updateLayerVisibility(layerId, visible) {
        const layer = layers.get(layerId);
        if (!layer) return;

        if (visible && !map.hasLayer(layer)) {
          layer.addTo(map);
          
          // Update LOD for parcels
          if (layer._isLOD) {
            layer._updateLOD();
          }
        } else if (!visible && map.hasLayer(layer)) {
          layer.remove();
        }
      }

      // Initialize
      async function init() {
        // Load registry
        await loadRegistry();
        if (!registry) {
          console.error('Failed to load registry');
          return;
        }

        // Check if Leaflet is available
        if (typeof L === 'undefined') {
          console.error('Leaflet library not loaded');
          // Still render UI controls even without map
          renderModeButtons();
          renderLayerToggles();
          renderLegend();
          renderProvenance();
          setupEventHandlers();
          return;
        }

        // Initialize map
        map = L.map('map', { scrollWheelZoom: true }).setView(config.mapCenter, config.mapZoom);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        // Listen for zoom changes
        map.on('zoomend', () => {
          layers.forEach((layer, layerId) => {
            if (layer._isLOD && map.hasLayer(layer)) {
              layer._updateLOD();
            }
          });
        });

        // Load all layers
        for (const layerDef of registry.layers) {
          const layer = await loadLayer(layerDef);
          if (layer) {
            layers.set(layerDef.id, layer);
            
            // Set initial visibility
            const visible = layerDef.default_visible !== false;
            layerVisibility.set(layerDef.id, visible);
            
            if (visible) {
              layer.addTo(map);
            }
          }
        }

        // Render UI
        renderModeButtons();
        renderLayerToggles();
        renderLegend();
        renderProvenance();

        // Set initial mode
        setMode(currentMode);

        setupEventHandlers();
      }

      // Setup event handlers
      function setupEventHandlers() {

        // Info panel toggle
        const infoPanel = document.getElementById('info-panel');
        const panelHandle = document.getElementById('panel-handle');
        
        if (panelHandle) {
          panelHandle.addEventListener('click', () => {
            infoPanel.classList.toggle('expanded');
          });
        }

        // About panel toggle
        const aboutPanel = document.getElementById('about-panel');
        const aboutBtn = document.getElementById('about-btn');
        const closeAbout = document.getElementById('close-about');

        if (aboutBtn) {
          aboutBtn.addEventListener('click', () => {
            aboutPanel.classList.add('visible');
          });
        }

        if (closeAbout) {
          closeAbout.addEventListener('click', () => {
            aboutPanel.classList.remove('visible');
          });
        }

        if (aboutPanel) {
          aboutPanel.addEventListener('click', (e) => {
            if (e.target === aboutPanel) {
              aboutPanel.classList.remove('visible');
            }
          });
        }
      }

      document.addEventListener('DOMContentLoaded', init);
    </script>
  </body>
</html>
