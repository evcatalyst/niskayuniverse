<form id="submit-form" style="display:block;max-width:400px;margin:20px auto;padding:20px;border:1px solid #ccc;border-radius:8px;">
  <h3>Submit Water Quality Test</h3>

  <label for="email">Email (for attribution):</label>
  <input type="email" id="email" name="email" required placeholder="your.email@example.com">

  <label for="address">Address:</label>
  <div style="position:relative;">
    <input type="text" id="address" name="address" required placeholder="Start typing an address in Niskayuna..." autocomplete="off">
    <div id="address-suggestions" style="position:absolute;top:100%;left:0;right:0;background:white;border:1px solid #ccc;border-top:none;max-height:200px;overflow-y:auto;display:none;z-index:1000;"></div>
  </div>

  <label for="ph">pH (0-14):</label>
  <input type="number" id="ph" name="ph" step="0.1" min="0" max="14" placeholder="7.2">

  <label for="tds">TDS (ppm):</label>
  <input type="number" id="tds" name="tds" min="0" placeholder="150">

  <label for="temperature">Temperature (°F):</label>
  <input type="number" id="temperature" name="temperature" step="0.1" placeholder="68">

  <label for="lead">Lead (ppb, optional):</label>
  <input type="number" id="lead" name="lead" min="0" placeholder="2">

  <label for="notes">Notes:</label>
  <textarea id="notes" name="notes" maxlength="500" placeholder="Test conditions, observations..."></textarea>

  <button type="submit">Submit Test</button>
</form>

<script client:load>
  // Temporarily show form for demo
  const form = document.getElementById('submit-form');
  form.style.display = 'block';

  // Address autocomplete functionality
  const addressInput = document.getElementById('address');
  const suggestionsDiv = document.getElementById('address-suggestions');
  let debounceTimer;
  let selectedSuggestion = -1;

  // Debounced search function
  function debounceSearch(query) {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => searchAddresses(query), 300);
  }

  // Search addresses using Nominatim
  async function searchAddresses(query) {
    if (query.length < 3) {
      suggestionsDiv.style.display = 'none';
      return;
    }

    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query + ', Niskayuna, NY')}&limit=5&addressdetails=1`);
      const data = await response.json();

      if (data && data.length > 0) {
        showSuggestions(data);
      } else {
        suggestionsDiv.style.display = 'none';
      }
    } catch (error) {
      console.error('Address search error:', error);
      suggestionsDiv.style.display = 'none';
    }
  }

  // Show suggestions dropdown
  function showSuggestions(results) {
    suggestionsDiv.innerHTML = '';
    results.forEach((result, index) => {
      const div = document.createElement('div');
      div.textContent = result.display_name;
      div.style.padding = '8px';
      div.style.cursor = 'pointer';
      div.style.borderBottom = '1px solid #eee';
      div.addEventListener('click', () => selectSuggestion(result.display_name));
      div.addEventListener('mouseenter', () => {
        selectedSuggestion = index;
        highlightSuggestion();
      });
      suggestionsDiv.appendChild(div);
    });
    suggestionsDiv.style.display = 'block';
    selectedSuggestion = -1;
  }

  // Select a suggestion
  function selectSuggestion(address) {
    addressInput.value = address;
    suggestionsDiv.style.display = 'none';
    selectedSuggestion = -1;
  }

  // Highlight current suggestion
  function highlightSuggestion() {
    const suggestions = suggestionsDiv.children;
    for (let i = 0; i < suggestions.length; i++) {
      suggestions[i].style.backgroundColor = i === selectedSuggestion ? '#f0f0f0' : 'white';
    }
  }

  // Input event listeners
  addressInput.addEventListener('input', (e) => {
    debounceSearch(e.target.value);
  });

  addressInput.addEventListener('keydown', (e) => {
    if (suggestionsDiv.style.display === 'none') return;

    const suggestions = suggestionsDiv.children;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSuggestion = Math.min(selectedSuggestion + 1, suggestions.length - 1);
      highlightSuggestion();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSuggestion = Math.max(selectedSuggestion - 1, -1);
      highlightSuggestion();
    } else if (e.key === 'Enter' && selectedSuggestion >= 0) {
      e.preventDefault();
      selectSuggestion(suggestions[selectedSuggestion].textContent);
    } else if (e.key === 'Escape') {
      suggestionsDiv.style.display = 'none';
      selectedSuggestion = -1;
    }
  });

  // Hide suggestions when clicking outside
  document.addEventListener('click', (e) => {
    if (!addressInput.contains(e.target) && !suggestionsDiv.contains(e.target)) {
      suggestionsDiv.style.display = 'none';
      selectedSuggestion = -1;
    }
  });

  // Geocode address using Nominatim (OpenStreetMap)
  async function geocodeAddress(address) {
    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1`);
      const data = await response.json();
      if (data && data.length > 0) {
        return {
          latitude: parseFloat(data[0].lat),
          longitude: parseFloat(data[0].lon),
          displayName: data[0].display_name
        };
      }
    } catch (error) {
      console.error('Geocoding error:', error);
    }
    return null;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Geocoding...';
    submitBtn.disabled = true;

    try {
      const formData = new FormData(form);
      const address = formData.get('address') || 'Niskayuna, NY';

      // Geocode the address
      const geocoded = await geocodeAddress(address);
      let coords, displayAddress;

      if (geocoded) {
        coords = [geocoded.latitude, geocoded.longitude];
        displayAddress = geocoded.displayName;
      } else {
        // Fallback to mock coordinates
        coords = [42.7851 + (Math.random() - 0.5) * 0.01, -73.8949 + (Math.random() - 0.5) * 0.01];
        displayAddress = address + ' (approximate location)';
      }

      const data = {
        address: displayAddress,
        pH: parseFloat(formData.get('ph')) || 7.0,
        tds: parseInt(formData.get('tds')) || null,
        temperature: parseFloat(formData.get('temperature')) || null,
        lead: parseInt(formData.get('lead')) || null,
        notes: formData.get('notes') || '',
        latitude: coords[0],
        longitude: coords[1],
        photoURLs: '', // TODO: Add photo upload later
        email: formData.get('email') // Include email in the submission
      };

      // Submit to Google Apps Script
      const isLocalhost = window.location.hostname === 'localhost';
      if (isLocalhost) {
        // For local development, simulate successful submission
        console.log('Local development: Simulating submission to Google Apps Script');
        
        // Add marker to map immediately for local testing
        if (window.addMarkerToMap) {
          window.addMarkerToMap({
            ...data,
            userEmail: data.email,
            userName: '',
            timestamp: new Date().toISOString()
          });
        }
        
        alert(`Test submitted successfully! Added marker at ${displayAddress} (pH: ${data.pH})`);
        form.reset();
        return;
      }

      const response = await fetch('https://script.google.com/macros/s/AKfycbyBZ0cIYn8LhD97R2xw7YEqcsbVy6Bx4XAUGUCaGpyR6W7pQza89Sa-egAlIuwAPgbkxA/exec', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data)
      });

      const result = await response.json();
      if (!result.ok) {
        throw new Error(result.error || 'Submission failed');
      }

      alert(`Test submitted successfully! Added marker at ${displayAddress} (pH: ${data.pH})`);

      form.reset();
    } catch (error) {
      console.error('Submission error:', error);
      alert('Error submitting test: ' + error.message);
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>